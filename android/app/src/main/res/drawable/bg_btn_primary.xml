<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_overlay_pressed">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <gradient
                        android:angle="45"
                        android:startColor="#0369a1"
                        android:endColor="#38bdf8" />
                    <corners android:radius="10dp" />
                    <stroke android:width="2dp" android:color="#ffffff" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape>
                    <gradient
                        android:angle="45"
                        android:startColor="#0369a1"
                        android:endColor="#38bdf8" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.2dp" android:color="#bae6fd" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient
                        android:angle="45"
                        android:startColor="#0284c7"
                        android:endColor="#0ea5e9" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
