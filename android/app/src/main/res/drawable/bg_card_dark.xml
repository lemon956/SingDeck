<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_card_elevated" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/border_glow" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="@color/surface_card_elevated" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/border_glow" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_card" />
            <corners android:radius="14dp" />
            <stroke android:width="1.2dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
