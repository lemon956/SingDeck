<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/btn_overlay_pressed">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/surface_glass" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.8dp" android:color="@color/border_glow" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape>
                    <solid android:color="@color/surface_glass" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.5dp" android:color="@color/border_glow" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_card_elevated" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="@color/border_light" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
