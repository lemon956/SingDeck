<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_idle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="策略与节点诊断 (Inspector)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_inspector_channel_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="严格本地通道 · 等待 VPN"
                    android:textColor="@color/status_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_inspector"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="关闭 Inspector"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- 1. Inspected Node Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_inspector_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="选择一个节点"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_inspector_node_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="来源 -- · 评分 -- · 延迟 --"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_inspector_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:minHeight="68dp"
                android:padding="10dp"
                android:lineSpacingExtra="2dp"
                android:text="尚未检测。长按节点可在这里查看来源、评分、出口风险与 Gemini 位置。"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <!-- 3 Probe Action Buttons (Equal weight & clear labels) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_inspector_score"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="综合评分"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btn_inspector_risk"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="出口风险"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btn_inspector_gemini"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Gemini 探测"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_gemini_login"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="打开私有 Gemini 登录页"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 2. Strategy Group Settings Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="策略组参数配置"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_inspector_test_url"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="真实延迟测试 URL (如 http://cp.cloudflare.com/generate_204)"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_inspector_mode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field" />

            <Spinner
                android:id="@+id/spinner_inspector_scheme"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field" />

            <EditText
                android:id="@+id/et_inspector_interval"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="分钟"
                android:inputType="number"
                android:singleLine="true"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_source_restriction"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="仅允许指定来源的节点"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_allowed_sources"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:text="选择允许来源"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_allow_unlabeled"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="同时允许未标记节点"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_probe"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="VPN 运行期间自动检测"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_auto_switch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="检测后自动切换到推荐节点"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_gemini_probe"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="在此策略组启用 Gemini 位置检测"
            android:textColor="@color/text_primary" />

        <!-- 3. Exit Risk Checkboxes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="出口风险项检测"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="2">

            <CheckBox android:id="@+id/check_risk_exit_ip" style="@style/InspectorRiskCheck" android:text="出口 IP" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_address_scope" style="@style/InspectorRiskCheck" android:text="地址范围" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_network_identity" style="@style/InspectorRiskCheck" android:text="网络身份" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_network_class" style="@style/InspectorRiskCheck" android:text="网络类型" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_route_security" style="@style/InspectorRiskCheck" android:text="RPKI 验证" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_tor" style="@style/InspectorRiskCheck" android:text="Tor 出口" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_privacy" style="@style/InspectorRiskCheck" android:text="隐私信号" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/check_risk_abuse" style="@style/InspectorRiskCheck" android:text="滥用信誉" android:textColor="@color/text_secondary" />
        </GridLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_inspector_settings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:text="保存此策略组配置"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
