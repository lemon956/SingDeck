<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的主力机场"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_profile_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="URL"
            android:textColor="@color/status_cyan"
            android:textSize="11sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@drawable/bg_badge_idle" />

        <TextView
            android:id="@+id/tv_profile_active_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ACTIVE"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/bg_badge_running" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_profile_node_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="节点数: 16"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_export_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_save"
            android:contentDescription="导出配置"
            android:background="@drawable/bg_badge_idle"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btn_edit_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="编辑配置"
            android:background="@drawable/bg_badge_idle"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btn_refresh_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="刷新订阅"
            android:background="@drawable/bg_badge_idle"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btn_delete_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="删除配置"
            android:background="@drawable/bg_badge_idle"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_activate_profile"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:text="切换使用此配置"
        android:textColor="@color/status_cyan"
        android:textSize="11sp"
        android:background="@drawable/bg_badge_idle" />
</LinearLayout>
