<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_card_dark">

    <!-- Top Row: Name, Type Badge, Active Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的主力机场方案"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_profile_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="URL"
            android:textColor="@color/status_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_badge_engine" />

        <TextView
            android:id="@+id/tv_profile_active_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ACTIVE"
            android:textColor="@color/status_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_badge_running" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/border_subtle" />

    <!-- Action Bar Row: Node Count & 4 Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_profile_node_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="包含 16 个可选节点"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_export_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_save"
            app:tint="@color/text_secondary"
            android:contentDescription="导出 Sing-box JSON 文件"
            android:tooltipText="导出 Sing-box JSON 文件"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btn_edit_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary"
            android:contentDescription="编辑配置 JSON 源码"
            android:tooltipText="编辑配置 JSON 源码"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/btn_refresh_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="@color/status_cyan"
            android:contentDescription="刷新订阅"
            android:tooltipText="刷新订阅"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/btn_delete_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/status_red"
            android:contentDescription="删除此方案"
            android:tooltipText="删除此方案"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Bottom Switch Active Button -->
    <Button
        android:id="@+id/btn_activate_profile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="10dp"
        android:text="切换使用此配置"
        android:textColor="@color/status_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_secondary" />
</LinearLayout>
