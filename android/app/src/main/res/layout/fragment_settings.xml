<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Profiles Section Header & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="配置方案与订阅 (Profiles)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_quick_import_clipboard"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⚡ 极速导入"
                android:textColor="@color/status_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_idle"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                android:id="@+id/btn_add_profile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:text="+ 新建"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Import Channels Actions Bar (Row 1: QR & Local File) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_scan_qr"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="📷 扫码导入"
                android:textColor="@color/status_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_idle" />

            <Button
                android:id="@+id/btn_scan_gallery"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="🖼️ 相册二维码"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_idle" />

            <Button
                android:id="@+id/btn_import_local_file"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="📁 本地文件"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_idle" />
        </LinearLayout>

        <!-- Backup & Restore Actions Bar (Row 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_backup_all"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="📦 备份全量配置"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_idle" />

            <Button
                android:id="@+id/btn_restore_backup"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="📥 还原配置备份"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_idle" />
        </LinearLayout>

        <!-- Profiles List RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <!-- Sing-box Native Route Rules Card (分流规则遵循 Sing-box 配置文件) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sing-box 路由分流 (Route Rules)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:text="当前激活配置"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_running" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_route_rules_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="读取当前激活配置中的 sing-box route.rules"
                android:textColor="@color/status_cyan"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="应用不会额外伪造分流规则；启动时由 sing-box 1.14 校验并执行配置中的 DNS、路由和出站定义。"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btn_edit_active_route"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:text="🔍 查看 / 修改当前配置完整 JSON 规则"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_badge_idle" />
        </LinearLayout>

        <!-- Optional Per-App Split Tunneling Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_card_dark">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用层分流 (可选扩展)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="针对特定应用包名设置是否进入 VPN 通道"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/rg_split_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_split_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="全部应用"
                    android:checked="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_split_whitelist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="白名单应用"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_split_blacklist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="黑名单应用"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_pick_apps"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:text="📱 选择分流应用清单 (0 个已选)"
                android:textColor="@color/status_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_idle" />
        </LinearLayout>

        <!-- Permissions & Optimization -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_card_dark">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统权限与后台保活"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="VPN、通知和电池优化权限由 Android 按需授权；未授权时会在实际操作处提示。"
                android:textColor="@color/status_green"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
