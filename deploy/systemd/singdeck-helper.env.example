# Copy this file to /etc/singdeck/helper.env and adjust paths/URLs.
SINGDECK_HELPER_BIND=0.0.0.0:9531
SINGDECK_HELPER_DB=/var/lib/singdeck/helper.db

# Optional: public base URL used to build /api/v1/config/raw links.
# SINGDECK_HELPER_PUBLIC_URL=http://192.168.1.20:9531

# Optional provider keys. Residential/data-center detection works without a
# key; a free proxycheck.io key raises its daily request allowance.
# SINGDECK_PROXYCHECK_KEY=
# The advanced checks below remain independent and are never called unless
# their individual strategy-group switches are enabled.
# SINGDECK_IPINFO_TOKEN=
# SINGDECK_ABUSEIPDB_KEY=
