# Copy this file to /etc/singdeck/helper.env and adjust paths/URLs.
SINGDECK_HELPER_BIND=127.0.0.1:9531
SINGDECK_HELPER_DB=/var/lib/singdeck/helper.db

# Optional: public base URL used to build /api/v1/config/raw links.
# SINGDECK_HELPER_PUBLIC_URL=http://192.168.1.20:9531

# Optional fallback: Chrome profile used by the Provider Traffic module on Linux.
# The value can also be configured in SingDeck Settings and is stored in helper.db.
# SINGDECK_BROWSER_PROFILE=/home/singdeck/.config/google-chrome/Default
