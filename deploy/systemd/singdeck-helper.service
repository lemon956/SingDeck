[Unit]
Description=SingDeck helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/singdeck
EnvironmentFile=-/etc/singdeck/helper.env
ExecStart=/usr/bin/env SINGDECK_HELPER_BIND=0.0.0.0:9531 /opt/singdeck/singdeck-helper
Restart=on-failure
RestartSec=3
StateDirectory=singdeck

[Install]
WantedBy=multi-user.target
